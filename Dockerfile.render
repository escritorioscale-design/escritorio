# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM node:24-trixie-slim AS proto-builder
WORKDIR /usr/src
COPY messages/package-lock.json messages/package.json ./
RUN npm ci
COPY messages .
COPY libs ./../libs
RUN npm run tag-version && npm run ts-proto

FROM --platform=$BUILDPLATFORM node:24-trixie-slim AS app-builder
ARG NODE_OPTIONS="--max-old-space-size=8192"
WORKDIR /usr/src
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY patches ./patches
COPY play/package.json play/package.json
COPY play/packages/iframe-api-typings/package.json play/packages/iframe-api-typings/package.json
COPY back/package.json back/package.json
COPY map-storage/package.json map-storage/package.json
COPY uploader/package.json uploader/package.json
COPY libs/messages/package.json libs/messages/package.json
COPY libs/map-editor/package.json libs/map-editor/package.json
COPY libs/math-utils/package.json libs/math-utils/package.json
COPY libs/tailwind/package.json libs/tailwind/package.json
COPY libs/store-utils/package.json libs/store-utils/package.json
COPY libs/shared-utils/package.json libs/shared-utils/package.json
RUN npm ci \
    --workspace=workadventure-play \
    --workspace=workadventureback \
    --workspace=map-storage \
    --workspace=workadventureuploader
COPY libs ./libs
COPY --from=proto-builder /usr/libs/messages/src ./libs/messages/src
COPY play ./play
COPY back ./back
COPY map-storage ./map-storage
COPY uploader ./uploader
COPY --from=proto-builder /usr/src/generated ./play/src/messages/generated
COPY --from=proto-builder /usr/src/generated ./back/src/Messages/generated
ENV NODE_ENV=production
RUN cd play && npm run typesafe-i18n && npm run build-iframe-api && npm run build
RUN cd map-storage && PATH_PREFIX=/map-storage npm run front:build

FROM app-builder AS validation
RUN ./node_modules/.bin/prettier --check \
    play/src/pusher/enums/EnvironmentVariableValidator.ts \
    play/src/pusher/enums/EnvironmentVariable.ts \
    play/src/pusher/services/RedisClient.ts \
    back/src/Enum/EnvironmentVariableValidator.ts \
    back/src/Enum/EnvironmentVariable.ts \
    back/src/Services/RedisClient.ts \
    map-storage/src/Enum/EnvironmentVariableValidator.ts \
    map-storage/src/Enum/EnvironmentVariable.ts \
    map-storage/src/index.ts \
    uploader/src/Enum/EnvironmentVariable.ts \
    uploader/src/Service/RedisStorageProvider.ts \
    uploader/server.ts
RUN npm run typecheck --workspace=workadventure-play
RUN npm run typecheck --workspace=workadventureback
RUN npm run typecheck --workspace=map-storage
RUN npm run typecheck --workspace=workadventureuploader -- --skipLibCheck

FROM matthiasluedtke/iconserver:v3.21.0 AS iconserver

FROM node:24-trixie-slim AS runtime
WORKDIR /usr/src
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl dumb-init gosu nginx \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default
COPY package.json package-lock.json ./
COPY play/package.json play/package.json
COPY play/packages/iframe-api-typings/package.json play/packages/iframe-api-typings/package.json
COPY back/package.json back/package.json
COPY map-storage/package.json map-storage/package.json
COPY uploader/package.json uploader/package.json
COPY libs/messages/package.json libs/messages/package.json
COPY libs/map-editor/package.json libs/map-editor/package.json
COPY libs/math-utils/package.json libs/math-utils/package.json
COPY libs/tailwind/package.json libs/tailwind/package.json
COPY libs/store-utils/package.json libs/store-utils/package.json
COPY libs/shared-utils/package.json libs/shared-utils/package.json
RUN npm ci --omit=dev \
    --workspace=workadventure-play \
    --workspace=workadventureback \
    --workspace=map-storage \
    --workspace=workadventureuploader
COPY --from=app-builder /usr/src/libs ./libs
COPY --from=app-builder /usr/src/play ./play
COPY --from=app-builder /usr/src/back ./back
COPY --from=app-builder /usr/src/map-storage ./map-storage
COPY --from=app-builder /usr/src/uploader ./uploader
COPY maps ./maps
COPY --from=iconserver /iconserver /usr/local/bin/iconserver
COPY deploy/render/nginx.conf.template /etc/nginx/nginx.conf.template
COPY deploy/render/start.sh /usr/local/bin/start-workadventure
RUN chmod +x /usr/local/bin/start-workadventure /usr/local/bin/iconserver \
    && mkdir -p /data/maps \
    && chown -R node:node /data/maps /usr/src/play /usr/src/back /usr/src/map-storage /usr/src/uploader
ENV NODE_ENV=production
ENV UWS_HTTP_MAX_HEADERS_SIZE=16384
EXPOSE 10000
HEALTHCHECK --interval=15s --timeout=8s --start-period=180s --retries=5 CMD curl -fsS http://127.0.0.1:${PORT:-10000}/health || exit 1
ENTRYPOINT ["dumb-init", "--"]
CMD ["/usr/local/bin/start-workadventure"]
