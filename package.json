{
  "name": "orbit-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:dev": "node scripts/setup-dev.mjs",
    "dev": "npm run dev -w @orbit/web",
    "dev:web": "npm run dev -w @orbit/web",
    "dev:realtime": "npm run dev -w @orbit/realtime",
    "build": "npm run db:generate && npm run build -w @orbit/web && npm run build -w @orbit/realtime",
    "db:generate": "npm run generate -w @orbit/db",
    "db:migrate": "npm run migrate -w @orbit/db",
    "db:studio": "npm run studio -w @orbit/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1"
  },
  "allowScripts": {
    "prisma@6.12.0": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.25.12": true
  }
}
