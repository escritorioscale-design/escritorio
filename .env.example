# Web and authentication
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://orbit:orbit@localhost:54320/orbit

# Comma-separated emails allowed to self-serve create a new organization
# (office) from the onboarding screen. Everyone else needs an invite link.
ADMIN_EMAILS=you@example.com

# Short-lived realtime gateway tokens. Use a different secret from auth.
REALTIME_TOKEN_SECRET=replace-with-another-32-character-random-secret
NEXT_PUBLIC_REALTIME_URL=http://localhost:3101

# LiveKit (local values match docker-compose.yml only)
NEXT_PUBLIC_MEDIA_PROVIDER=livekit
LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecret

# Cloudflare Realtime SFU (server-only; never prefix the secret with NEXT_PUBLIC_)
# Set MEDIA_PROVIDER=cloudflare on the realtime service and
# NEXT_PUBLIC_MEDIA_PROVIDER=cloudflare on the web service when enabling it.
MEDIA_PROVIDER=livekit
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# Realtime infrastructure
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3100
PORT=3101
NODE_ENV=development
